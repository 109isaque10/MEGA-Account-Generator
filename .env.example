# Server HTTP Port
PORT=3000

# Email pattern and domain for account generation
# Pattern supports printf-style integer format (e.g., mega%d, user-%04d)
EMAIL_PATTERN=mega%d
EMAIL_DOMAIN=example.com

# Interval in days for the low-resource background keep-alive logins
SIGNIN_INTERVAL_DAYS=30

# Mailgun webhook credentials (optional: if omitted, signature check is bypassed for local testing)
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Path to megatools binary
MEGATOOLS_PATH=megatools

# Optional default password (if empty, strong random password generated per account)
MEGA_DEFAULT_PASSWORD=

# Data persistence directory (accounts.csv, accounts.json)
DATA_DIR=.
